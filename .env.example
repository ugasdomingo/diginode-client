VITE_API_URL=http://localhost:3000/api
# El enlace real de Cal.com lo entrega GET /api/services. No uses placeholders.
# Publicidad desactivada por código, incluso si existe un ID antiguo.
VITE_META_PIXEL_ID=

# Activar solo tras revisar la medición y el aviso de privacidad del entorno.
# Aunque esté a true, no se envía nada hasta que la persona acepte la medición.
VITE_ENABLE_ANALYTICS=false

# true = datos de demostración (docs/api-operacion.md). false o sin definir = API real.
# En Vercel, para producción, déjalo en false (o no lo definas) y apunta VITE_API_URL a la API.
VITE_OPS_USE_MOCK=false

# Calendario incrustado. Vacío = no hay iframe. Si hay URL, solo se carga tras el permiso de incrustados.
VITE_SCHEDULING_EMBED_URL=
