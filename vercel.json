{
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/demo/?", "status": 308, "headers": { "Location": "/clinica-digital#demo-nora" } },
    { "src": "/plan/?", "status": 308, "headers": { "Location": "/clinica-digital" } },
    { "src": "/clinica-digital/?", "dest": "/clinica-digital/index.html" },
    { "src": "/webs-y-aplicaciones/?", "dest": "/webs-y-aplicaciones/index.html" },
    { "handle": "filesystem" },
    { "src": "/assets/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
