{
  "name": "diginode-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lab": "vite --config vite.lab.config.js",
    "lab:build": "vite build --config vite.lab.config.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,vue}\"",
    "review:build": "node scripts/review-build.mjs",
    "review": "node scripts/review-static.mjs",
    "test:static": "node scripts/verify-static.mjs"
  },
  "dependencies": {
    "@tinymce/tinymce-vue": "^6.3.0",
    "dompurify": "^3.4.9",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/server-renderer": "^3.5.29",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "sass": "^1.85.1",
    "vite": "^6.2.1"
  }
}
